# Copy this file to .env for local development.
# Never commit real secrets, Wi-Fi passwords, broker passwords, or tokens.

APP_ENV=development

TEMPEST_SERIAL_PORT=COM3
TEMPEST_SERIAL_BAUD_RATE=9600
TEMPEST_BACKEND_URL=http://127.0.0.1:8000/readings
TEMPEST_BACKEND_BASE_URL=http://127.0.0.1:8000

POSTGRES_DB=tempest
POSTGRES_USER=tempest
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://tempest:change-me-local-only@localhost:5432/tempest

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=tempest_device
MQTT_PASSWORD=change-me-local-only

